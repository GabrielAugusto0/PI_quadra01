# Copie para .env (local) ou cadastre em Settings > Environment Variables (Vercel).
# Obrigatória:
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO

# Opcionais (login administrativo via Manus; sem elas o painel interno fica sem login em produção):
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
# MANUS_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
